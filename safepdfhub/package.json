    "jszip": "^3.10.1",
    "lucide-angular": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "5.3.31",
    "qpdf-run": "0.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "@neslinesli93/qpdf-wasm": "0.3.0"
