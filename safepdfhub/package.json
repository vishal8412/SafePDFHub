    "benchmark:sign-pdf:stress:full": "python scripts/phase2.5-sign-pdf-stress.py --start-server --profile full",
    "sign:audit": "node scripts/sign-pdf-security-audit.mjs",
    "sign:ux:audit": "node scripts/sign-pdf-ux-audit.mjs",
    "watermark:audit": "node scripts/watermark-audit.mjs",
