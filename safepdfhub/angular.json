{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "safepdfhub": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/assets",
              {
                "glob": "pdf.worker.min.mjs",
                "input": "node_modules/pdfjs-dist/build/",
                "output": "assets/pdfjs/"
              },
              {
                "glob": "qpdf.wasm",
                "input": "node_modules/@neslinesli93/qpdf-wasm/dist/",
                "output": "assets/qpdf/"
              },
              {
                "glob": "robots.txt",
                "input": "src/seo",
                "output": "/"
              },
              {
                "glob": "sitemap.xml",
                "input": "src/seo",
                "output": "/"
              },
              {
                "glob": "**/*",
                "input": "node_modules/pdfjs-dist/cmaps",
                "output": "assets/pdfjs/cmaps"
              },
              {
                "glob": "**/*",
                "input": "node_modules/pdfjs-dist/standard_fonts",
                "output": "assets/pdfjs/standard_fonts"
              },
              {
                "glob": "**/*",
                "input": "node_modules/pdfjs-dist/wasm",
                "output": "assets/pdfjs/wasm"
              },
              {
                "glob": "worker.min.js",
                "input": "node_modules/tesseract.js/dist",
                "output": "assets/ocr"
              },
              {
                "glob": "*.wasm*",
                "input": "node_modules/tesseract.js-core",
                "output": "assets/ocr/core"
              }
            ],
            "styles": [
              "src/styles.scss"
            ],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": [
                "safepdfhub.com",
                "www.safepdfhub.com"
              ]
            },
            "ssr": {
              "entry": "src/server.ts"
            },
            "webWorkerTsConfig": "tsconfig.worker.json",
            "allowedCommonJsDependencies": [
              "@neslinesli93/qpdf-wasm",
              "tesseract.js"
            ],
            "deleteOutputPath": true
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "40kB",
                  "maximumError": "50kB"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "src/app/app.routes.development.ts",
                  "with": "src/app/app.routes.production.ts"
                }
              ],
              "assets": [
                {
                  "glob": "**/*",
                  "input": "src/assets",
                  "output": "assets",
                  "ignore": [
                    "**/*.md",
                    "qpdf/f2r2/**",
                    "pdf.worker.mjs",
                    "safepdfhub-icon-final.png",
                    "safepdfhub-logo-final.png"
                  ]
                },
                {
                  "glob": "pdf.worker.min.mjs",
                  "input": "node_modules/pdfjs-dist/build/",
                  "output": "assets/pdfjs/"
                },
                {
                  "glob": "qpdf.wasm",
                  "input": "node_modules/@neslinesli93/qpdf-wasm/dist/",
                  "output": "assets/qpdf/"
                },
                {
                  "glob": "robots.txt",
                  "input": "src/seo",
                  "output": "/"
                },
                {
                  "glob": "sitemap.xml",
                  "input": "src/seo",
                  "output": "/"
                },
                {
                  "glob": "**/*",
                  "input": "node_modules/pdfjs-dist/cmaps",
                  "output": "assets/pdfjs/cmaps"
                },
                {
                  "glob": "**/*",
                  "input": "node_modules/pdfjs-dist/standard_fonts",
                  "output": "assets/pdfjs/standard_fonts"
                },
                {
                  "glob": "**/*",
                  "input": "node_modules/pdfjs-dist/wasm",
                  "output": "assets/pdfjs/wasm"
                },
                {
                  "glob": "worker.min.js",
                  "input": "node_modules/tesseract.js/dist",
                  "output": "assets/ocr"
                },
                {
                  "glob": "*.wasm*",
                  "input": "node_modules/tesseract.js-core",
                  "output": "assets/ocr/core"
                }
              ],
              "sourceMap": false
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "safepdfhub:build:production"
            },
            "development": {
              "buildTarget": "safepdfhub:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
