+  pointer-events: none;
+  background: transparent;
+}
+.studio-text-toolbar { width: max-content; flex-wrap: nowrap; overflow-x: auto; }
+.studio-text-toolbar > button, .studio-text-toolbar__size, .studio-text-toolbar__divider { flex-shrink: 0; }
+.studio-text-toolbar__cell-hint { font-size: 11px; color: #8ca2b5; white-space: nowrap; }
+.studio-text-editor { overflow-wrap: anywhere; }
+
+@font-face {font-family:StudioFallback;src:url('/assets/fonts/DejaVuSans-Bold.ttf') format('truetype');font-weight:700;font-style:normal;font-display:swap;}
+
+@font-face {font-family:StudioFallback;src:url('/assets/fonts/DejaVuSans-Oblique.ttf') format('truetype');font-weight:400;font-style:italic;font-display:swap;}
+
+@font-face {font-family:StudioFallback;src:url('/assets/fonts/DejaVuSans-BoldOblique.ttf') format('truetype');font-weight:700;font-style:italic;font-display:swap;}
+
+.studio-sign-placement-hint { position:absolute; top:8px; left:50%; transform:translateX(-50%); z-index:80; display:flex; align-items:center; gap:12px; max-width:calc(100% - 24px); padding:10px 14px; border:1px solid #26c9b5; border-radius:10px; background:#0b2432; color:#e6fffa; font-size:12px; box-shadow:0 5px 20px #0005; }
+.studio-sign-placement-hint button { border:1px solid #4a8b90; background:transparent; color:inherit; border-radius:6px; padding:6px 10px; cursor:pointer; }
+.studio-sign-ghost { position:absolute; z-index:70; pointer-events:none; border:1px dashed #00bfa5; border-radius:4px; background:#dcfff433; opacity:.7; display:grid; place-items:center; }
+.studio-sign-ghost img { width:100%; height:100%; object-fit:contain; }
+.studio-sign-ghost span { color:#183849; font-size:14px; }
+
+/* Wrap options inside the page instead of overflowing the viewport. */
+.studio-shape-palette:not(.studio-shape-palette--collapsed) {flex-wrap:wrap;width:max-content;max-width:calc(100% - 16px);white-space:normal;overflow:visible;gap:6px;}
+.studio-shape-palette > * {flex-shrink:0;}
+.studio-shape-palette__button {padding:6px 9px;}
+.studio-shape-palette__collapse {margin-left:auto;}
