+        width: 26px;
+        height: 26px;
+      }
+      h2 {
+        font-size: 21px;
+        margin: 18px 0 10px;
+      }
+      p {
+        font-size: 14px;
+        line-height: 1.6;
+        color: #c4d1e1;
+        margin: 0;
+      }
+      .exit-hint {
+        font-size: 12px;
+        margin-top: 12px;
+        color: #91a8c3;
+      }
+      .exit-actions {
+        display: flex;
+        flex-direction: column;
+        gap: 9px;
+        margin-top: 24px;
