+  .processing-status__separator,
+  .processing-status__state,
+  .info-button,
+  .status-divider,
+  .view-button,
+  .page-description {
+    display: none;
+  }
+
+  .processing-status__label {
+    max-width: 130px;
+  }
+
+  .studio-status-bar__right {
+    gap: 4px;
+  }
+
+  .zoom-step-button {
+    display: none;
+  }
+
+  .zoom-control {
+    height: 28px;
+  }
+
+  .zoom-select {
+    width: 50px;
+  }
+}
+
+
+/* ============================================================
+   SMALL MOBILE
+============================================================ */
+
+@media (max-width: 480px) {
+  .processing-status__icon {
+    width: 15px;
+    height: 15px;
+  }
+
+  .processing-status__icon svg {
+    width: 14px;
+    height: 14px;
+  }
+
+  .processing-status__label {
+    max-width: 100px;
+
+    font-size: 9px;
+  }
+
+  .page-indicator {
+    min-width: 58px;
+
+    padding-inline: 7px;
+
+    font-size: 10px;
+  }
+
+  .navigation-button {
+    width: 25px;
+    height: 25px;
+  }
+
+  .document-state__label {
+    display: none;
+  }
+}
+
+
+/* ============================================================
+   REDUCED MOTION
+============================================================ */
+
+@media (prefers-reduced-motion: reduce) {
+  .info-button,
+  .navigation-button,
+  .view-button,
+  .zoom-step-button {
+    transition: none;
+  }
+}
